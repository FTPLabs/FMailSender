# FMailSender RLM Agent — environment variables
  # Copy to .env and fill in values

  # OpenAI-compatible API key (gptvibe.ru)
  OPENAI_API_KEY=your-key-here

  # API base URL (gptvibe.ru is default — no account needed)
  OPENAI_BASE_URL=https://gptvibe.ru/v1

  # Model to use
  RLM_MODEL=gpt-4o-mini

  # GitHub token for push operations
  GITHUB_TOKEN=your-github-token
  