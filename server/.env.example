# FMail Sender — Server .env
  # Скопируй в .env и заполни все значения

  # ── Telegram ─────────────────────────────────────────────────
  BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
  ADMIN_IDS=REPLACE_WITH_TELEGRAM_ID_OF_ADMIN
  MODERATOR_IDS=

  # ── Crypto payments ──────────────────────────────────────────
  CRYPTO_BOT_TOKEN=REPLACE_WITH_CRYPTO_BOT_TOKEN

  # ── License API ──────────────────────────────────────────────
  # Минимум 32 символа! Один и тот же на клиенте и сервере.
  JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_FOR_JWT

  # ── Adminка ──────────────────────────────────────────────────
  # Твой постоянный API-ключ для доступа к /admin
  # Использование: https://fmail.shop/admin?api_key=YOUR_KEY
  #           или: curl -H "X-Admin-Api-Key: YOUR_KEY" https://fmail.shop/admin
  ADMIN_API_KEY=fmail_Q91vaRcIQg32UQLLK-pWpnu3B2zRrlN88I2agItRSrY

  # ── База данных ──────────────────────────────────────────────
  DB_PATH=/opt/fmailsender/server/licenses.db

  # ── Сервер ───────────────────────────────────────────────────
  API_HOST=127.0.0.1
  API_PORT=8000

  # ── HWID-шифрование (опционально) ───────────────────────────
  # Любая случайная строка — изолирует license.dat между машинами
  HWID_SALT=REPLACE_WITH_RANDOM_SALT

  # ── Скачивание ───────────────────────────────────────────────
  DOWNLOAD_URL=https://github.com/FTPLabs/FMailSender/releases/latest/download/FMailSender.exe

  # ── Telegram-канал для обязательной подписки ─────────────────
  CHANNEL_ID=-1003769139793
  